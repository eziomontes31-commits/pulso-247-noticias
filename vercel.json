{
  "version": 2,
  "crons": [
    {
      "path": "/api/bot-run",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "api/bot-run.js": {
      "maxDuration": 10
    },
    "api/image.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
